generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String?
  name             String?
  stripeCustomerId String?
  plan             String           @default("free") // free | pro | business
  role             String           @default("user") // user | admin
  defaultTone      String?          @default("Professional")
  defaultLanguage  String?          @default("English")
  brandVoice       String?          @db.Text
  targetAudience   String?
  defaultFramework String?          @default("AIDA")
  createdAt        DateTime         @default(now())
  products         Product[]
  promptTemplates  PromptTemplate[]
  usageLogs        UsageLog[]
  subscription     Subscription?
  paymentRequests  PaymentRequest[]
  bulkJobs         BulkJob[]
}

model PaymentRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          String   // pro | business
  amount        Float    // Dollar amount
  binanceId     String   // Binance ID / Pay ID
  transactionId String   // Binance Order ID / TxID
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  stripeSubscriptionId String
  status               String   // active, canceled, past_due
  plan                 String
  currentPeriodEnd     DateTime
}

model Product {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  imageUrl             String
  keywords             String[]
  language             String   @default("en")
  copywritingFramework String?  @default("AIDA") // AIDA | PAS | FAB
  bulletFeatures       String[]
  socialHook           String?  @db.Text
  targetAudience       String?
  generatedTitle       String?
  generatedDescription String?  @db.Text
  generatedTags        String[]
  seoMetaTitle         String?
  seoMetaDescription   String?  @db.Text
  keywordDensityScore  Int?     @default(85)
  promptTemplateId     String?
  createdAt            DateTime @default(now())
}

model PromptTemplate {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  name         String
  templateText String   @db.Text
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model UsageLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // "generate", "export"
  tokensUsed Int      @default(0)
  createdAt  DateTime @default(now())
}

model BulkJob {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  totalCount     Int      @default(0)
  processedCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

